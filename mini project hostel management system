    // ---------- Allocation Window ----------
    private static void showAllocationWindow() {
        JFrame f = new JFrame("Room Allocation");
        f.setSize(520,480); f.setLocationRelativeTo(null);
        f.setLayout(null);

        JLabel lsid = new JLabel("Student ID:"); lsid.setBounds(20,20,100,25); f.add(lsid);
        JTextField tsid = new JTextField(); tsid.setBounds(120,20,160,25); f.add(tsid);

        JLabel lroom = new JLabel("Select Room:"); lroom.setBounds(20,60,100,25); f.add(lroom);
        JComboBox<String> roomBox = new JComboBox<>();
        roomBox.setBounds(120,60,160,25);
        for(Room r:rooms) roomBox.addItem(r.no);
        f.add(roomBox);

        DefaultListModel<String> model = new DefaultListModel<>();
        JList<String> list = new JList<>(model);
        JScrollPane sp = new JScrollPane(list); sp.setBounds(20,140,460,260); f.add(sp);

        JButton alloc = new JButton("Allocate"); alloc.setBounds(300,20,90,60); f.add(alloc);
        JButton refresh = new JButton("Refresh List"); refresh.setBounds(400,20,120,60); f.add(refresh);
        JButton del = new JButton("Delete Selected"); del.setBounds(300,90,220,30); f.add(del);

        alloc.addActionListener(e -> {
            String sid = tsid.getText().trim();
            String roomNo = (String)roomBox.getSelectedItem();
            if(sid.isEmpty()) { JOptionPane.showMessageDialog(f,"Enter Student ID"); return; }
            boolean ok = false;
            for(Room r:rooms) {
                if(r.no.equals(roomNo) && r.status.equals("Vacant")) {
                    allocations.add(new Allocate(sid,roomNo));
                    r.status = "Occupied";
                    ok = true; break;
                }
            }
            if(ok) { JOptionPane.showMessageDialog(f,"Allocated"); tsid.setText(""); }
            else JOptionPane.showMessageDialog(f,"Room not available");
        });

        refresh.addActionListener(e -> { model.clear(); for(Allocate a: allocations) model.addElement(a.toString()); });

        del.addActionListener(e -> {
            int i = list.getSelectedIndex();
            if(i>=0) {
                String room = allocations.get(i).room;
                allocations.remove(i);
                for(Room r:rooms) if(r.no.equals(room)) r.status = "Vacant";
                model.remove(i);
                JOptionPane.showMessageDialog(f,"Deleted allocation and freed room");
            } else JOptionPane.showMessageDialog(f,"Select an allocation to delete");
        });

        f.setVisible(true);
    }
}
